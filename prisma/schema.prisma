// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// --- IDENTITY MODELS ---

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  username        String   @unique
  bio             String?
  specialization  String?
  reputationScore Int      @default(0)
  profileImageUrl String?
  joinDate        DateTime @default(now())

  // Relations
  profileInfo     ProfileInfo?
  posts           Post[]
  comments        Comment[]
  sessions        Session[]
  
  // Voting & Feedback Relations
  postVotes       PostVote[]      // Tracks every like/dislike by this user
  reputationLogs  ReputationLog[]
  reviewsWritten  Review[]        @relation("ReviewsWritten")
  reviewsReceived Review[]        @relation("ReviewsReceived")
}

model ProfileInfo {
  id       String  @id @default(cuid())
  location String?
  website  String?
  github   String?
  twitter  String?

  // 1:1 Relationship with User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- CONTENT MODELS ---

model Post {
  id        String     @id @default(cuid())
  title     String
  content   String     @db.Text
  status    PostStatus @default(DRAFT)
  tags      String[]
  views     Int        @default(0)
  imageUrl  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  authorId String
  author   User       @relation(fields: [authorId], references: [id])
  comments Comment[]
  
  // Normalized Votes (Replaces old 'likes' and 'dislikes' Int fields)
  votes    PostVote[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Relations
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Self-relation for nested replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
}

// --- NORMALIZED VOTING MODEL ---

model PostVote {
  id     String   @id @default(cuid())
  type   VoteType // Enum: LIKE or DISLIKE
  
  // Relations
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  postId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // This ensures a user can only have ONE vote (either Like or Dislike) per post
  @@unique([userId, postId])
  @@index([postId])
}

// --- LOGGING & REVIEW MODELS ---

model ReputationLog {
  id        String   @id @default(cuid())
  change    Int      // Amount added or subtracted
  reason    String   // Why the change happened
  newTotal  Int      // The user's score after this change
  timestamp DateTime @default(now())

  // Relation to User
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // Scale (e.g., 1-5)
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  // The User who wrote the review
  reviewerId String
  reviewer   User   @relation("ReviewsWritten", fields: [reviewerId], references: [id])

  // The User being reviewed
  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@index([revieweeId])
}

model Session {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  ipAddress String
  os        String
  browser   String

  // Relation to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- SYSTEM MODELS ---

model SystemStats {
  id        Int      @id @default(1)
  users     Int      @default(0)
  posts     Int      @default(0)
  kbStored  Float    @default(0)
  updatedAt DateTime @updatedAt
}

// --- ENUMS ---

enum PostStatus {
  PUBLISHED
  DRAFT
}

enum VoteType {
  LIKE
  DISLIKE
}