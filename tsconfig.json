{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowImportingTsExtensions": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* 1. Add this to fix the CSS and SVG import errors */
    "types": ["vite/client"],

    "paths": {
      "@/*": ["./src/*"],
      "@db": ["./server/generated/prisma"]
    }
  },
  "include": ["src", "server", "prisma", "vite.config.ts"],
  "exclude": ["node_modules"]
}
