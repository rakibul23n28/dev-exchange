{
  "compilerOptions": {
    /* To silence the specific warning if you wanted to keep it, 
       but it's better to just fix the config as shown below */
    "ignoreDeprecations": "5.0",

    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Modern Path Mapping (Notice the ./ prefix and no baseUrl) */
    "paths": {
      "@/*": ["./src/*"],
      "@db": ["./server/generated/prisma"]
    }
  },
  "include": ["src", "server", "prisma"],

  "exclude": ["node_modules"]
}
